# ============================================================
# UNIVERSITY TIMETABLE SYSTEM — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------
SECRET_KEY=django-insecure-hm00z_^i=pc3r^(2ahihyf(=5xyt6q9ao&ys)#qerbe%l&t&@k

# Admin (superuser) account — auto-created on first deploy by
# docker-entrypoint.sh if no superuser exists yet. Change the password
# here and redeploy to rotate it ONLY if no superuser exists (existing
# accounts are never touched automatically — reset via `manage.py
# changepassword` or the admin site instead).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,chukauniversitytimetabling.pythonanywhere.com,untorpid-sunday-unsavingly.ngrok-free.dev

# ------------------------------------------------------------------
# CSRF
# ------------------------------------------------------------------
CSRF_TRUSTED_ORIGINS=https://chukauniversitytimetabling.pythonanywhere.com

# ------------------------------------------------------------------
# TAILSCALE FUNNEL (mobile access without a public domain)
# ------------------------------------------------------------------
# deploy_production_webserver.sh asks (step 5) whether your domain is
# already publicly reachable. If not, it sets up Tailscale Funnel
# (step 11) and fills these in automatically — you don't need to set
# them by hand. See scripts/z_omega_deployment_script/11_tailscale_setup.sh.
#
# DEPLOY_PUBLIC_DOMAIN=false skips the interactive prompt on repeat
# runs and re-asserts Tailscale is up on every deploy ("on updates").
# TAILSCALE_FUNNEL_URL is the stable public https://*.ts.net link the
# script discovers — point the mobile app at it once; it doesn't
# change on later deploys. It includes a ":8443" port suffix (see
# TAILSCALE_FUNNEL_PUBLIC_PORT in 11_tailscale_setup.sh) because this
# project's nginx container already occupies host port 443, which would
# otherwise shadow Tailscale's own listener on that port.
#
# TAILSCALE_AUTHKEY (generate at
# https://login.tailscale.com/admin/settings/keys) lets the very first
# 'tailscale up' run unattended (--yes / no TTY); otherwise the script
# prints an interactive login URL to authorize this device once.
DEPLOY_PUBLIC_DOMAIN=
TAILSCALE_FUNNEL_URL=
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=

# ------------------------------------------------------------------
# DATABASE (MySQL)
# ------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ------------------------------------------------------------------
# EMAIL
# ------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SUPPORT_EMAIL=


# ------------------------------------------------------------------
# BACKUP & DISASTER RECOVERY
# ------------------------------------------------------------------
# Directory where backup files are written before any remote upload.
# Default: <project_root>/backups/  (created automatically)
BACKUP_ROOT=

# Celery / Redis broker (only needed if you run a Celery worker)
# Leave blank on PythonAnywhere — tasks fall back to daemon threads.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Disaster Recovery replica (leave blank to keep DR module dormant)
DR_REPLICA_HOST=
DR_REPLICA_PORT=3306
DR_REPLICA_DB_NAME=
DR_REPLICA_DB_USER=
DR_REPLICA_DB_PASSWORD=
