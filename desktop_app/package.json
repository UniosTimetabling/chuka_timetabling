{
  "name": "chuka-timetabling-desktop",
  "version": "1.0.0",
  "description": "Offline-capable desktop client for Chuka Timetabling System (main + exam timetable panels), with sync back to the Django server.",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64",
    "dist:all": "npm run build && electron-builder --win --linux --x64",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test:sync": "npm run build:main && node scripts/run-electron-node.js dist/main/tests/syncE2E.js",
    "test:e2e": "bash scripts/run-e2e.sh"
  },
  "author": "Chuka Timetabling",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.0",
    "vite": "^5.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "electron-updater": "^6.1.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "build": {
    "appId": "com.chuka.timetabling.desktop",
    "productName": "Chuka Timetabling",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/main/tests/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "python-runner", "to": "python-runner", "filter": ["**/*.py"] },
      { "from": "python-runtime/win", "to": "python-runtime/win", "filter": ["**/*"] },
      { "from": "python-runtime/linux", "to": "python-runtime/linux", "filter": ["**/*"] }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
