# ──────────────────────────────────────────────────────────────
# docker/mysql/conf.d/timetabling.cnf
# Custom MySQL 8.0 settings for Chuka University Timetabling DB
# ──────────────────────────────────────────────────────────────
[mysqld]
# Character set — full Unicode (emojis, special chars in names)
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

# Performance — adjust based on available RAM
innodb_buffer_pool_size   = 256M
innodb_log_file_size      = 64M
max_connections           = 150

# Strict SQL mode (matches Django expectations)
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

[client]
default-character-set = utf8mb4
